#include <stdio.h>

#define MAX 10

int visited[MAX];

// DFS function
void dfs(int graph[MAX][MAX], int n, int start)
{
    int i;

    printf("%d ", start);
    visited[start] = 1;

    for (i = 0; i < n; i++)
    {
        if (graph[start][i] == 1 && !visited[i])
        {
            dfs(graph, n, i);
        }
    }
}

int main()
{
    int graph[MAX][MAX];
    int n, i, j, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
        }
    }

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    printf("DFS Traversal: ");

    dfs(graph, n, start);

    return 0;
}
