#include<stdio.h>

int partition(int arr[], int low, int high)
{
    int pivot, i, j, temp;

    pivot = arr[low];
    i = low + 1;
    j = high;

    while(i <= j)
    {
        while(i <= high && arr[i] <= pivot)
        {
            i++;
        }

        while(arr[j] > pivot)
        {
            j--;
        }

        if(i < j)
        {
            temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
    }

    temp = arr[low];
    arr[low] = arr[j];
    arr[j] = temp;

    return j;
}

void quickSort(int arr[], int low, int high)
{
    int pos;

    if(low < high)
    {
        pos = partition(arr, low, high);

        quickSort(arr, low, pos-1);
        quickSort(arr, pos+1, high);
    }
}

int main()
{
    int arr[50], n, i;

    printf("Enter number of elements: ");
    scanf("%d",&n);

    printf("Enter elements:\n");

    for(i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }

    quickSort(arr,0,n-1);

    printf("Sorted Array:\n");

    for(i=0;i<n;i++)
    {
        printf("%d ",arr[i]);
    }

    return 0;
}
