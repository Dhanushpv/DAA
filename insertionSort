#include<stdio.h>

int main(){
    int arr[50],i,j,n,key;

    printf("Enter the number of Array : \n");
    scanf("%d",&n);

    printf("Enter the elements :\n");
    for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }

    for(i=0;i<n;i++){

        key = arr[i];
        j=i-1;

        while(j>=0 && arr[j]>key){
            arr[j+1]= arr[j];
            j--;
        }
        arr[j+1] = key;
    }
    printf("The Sorted Array : \n");
    for(i=0;i<n;i++){
        printf("%d ",arr[i]);
    }
}
