#include <stdio.h>

int main(){
    int arr[50],i,n,j;
    int min;
    int temp;

    printf("Enter the number of elements : ");
    scanf("%d",&n);

    printf("Enter the elements ");
    for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }

    for(i=0;i<n;i++){
        min = i;
        for(j=i+1;j<n;j++){
            if(arr[j]<arr[min]){
                min = j;

            }
        }

        temp=arr[i];
        arr[i] = arr[min];
        arr[min]=temp;
    }
    printf("Sorted Elements");
    for(i=0;i<n;i++){
        printf("%d",arr[i]);
    }

}
