#include <stdio.h>

int main(){
    int arr[50],i,j,n;
    int temp;

    printf("Enter the number of elements : \n");
    scanf("%d",&n);

    printf("Enter the elements \n");
    for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }

     printf(" Before Sorting Array \n");
    for(i=0;i<n;i++){
        printf("%d \n",arr[i]);
    }

    for(i=0;i<n;i++){
        for(j=0;j<n-i-1;j++){
            if(arr[j]>arr[j+1]){
                temp = arr[j];
                arr[j]=arr[j+1];
                arr[j+1]= temp;
            }
        }
    }
    printf("Sorted Array \n");
    for(i=0;i<n;i++){
        printf("%d \n",arr[i]);
    }
}
