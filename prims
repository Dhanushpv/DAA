#include<stdio.h>

#define MAX 10

int main()

{

    int n, i, j;

    int cost[MAX][MAX];

    int visited[MAX];

    int min, u, v;

    int total = 0;

    printf("Enter number of vertices: ");

    scanf("%d", &n);

    printf("Enter cost matrix:\n");

    for(i = 0; i < n; i++)

    {

        for(j = 0; j < n; j++)

        {

            scanf("%d", &cost[i][j]);

            /* replace 0 with large value (no edge) */

            if(cost[i][j] == 0)

                cost[i][j] = 999;

        }

    }

    /* initialize visited */

    for(i = 0; i < n; i++)

        visited[i] = 0;

    visited[0] = 1;   // start from vertex 0

    printf("Edges in MST:\n");

    for(int k = 0; k < n-1; k++)

    {

        min = 999;

        for(i = 0; i < n; i++)

        {

            if(visited[i])

            {

                for(j = 0; j < n; j++)

                {

                    if(!visited[j] && cost[i][j] < min)

                    {

                        min = cost[i][j];

                        u = i;

                        v = j;

                    }

                }

            }

        }

        printf("%d -- %d = %d\n", u, v, min);

        total += min;

        visited[v] = 1;

    }

    printf("Total cost = %d\n", total);

    return 0;

}
